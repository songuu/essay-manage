# Copy this file to /opt/essay-manage/shared/.env.production on the server.
# Replace every change-me value. URL-encode reserved characters in DATABASE_URL.
POSTGRES_DB=essay_manage
POSTGRES_USER=essay_manage
POSTGRES_PASSWORD=change-me-with-a-long-random-secret
DATABASE_URL=postgresql://essay_manage:change-me-with-a-long-random-secret@db:5432/essay_manage

